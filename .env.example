# Copy to `.env.local` and fill in values.

# Resend
RESEND_API_KEY=
REPORT_TO_EMAIL=shaybit@airoboticsdrones.com
RESEND_FROM_EMAIL=

# Admin
ADMIN_EMAIL=shaybit@airoboticsdrones.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Firebase (Firestore) — required for production on Vercel
# Option A: paste the full service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: split service account fields
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
